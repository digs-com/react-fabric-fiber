{
  "name": "react-fabric-fiber-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "typecheck": "pnpm -r --if-present run typecheck",
    "build": "pnpm -r --if-present run build",
    "test": "vitest run",
    "dev": "pnpm --filter homepage dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm typecheck:root && pnpm test",
    "harness": "vite test/pdf-harness",
    "typecheck:root": "tsc -p tsconfig.json",
    "harness:compare": "vitest run --config test/pdf-harness/vitest.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@napi-rs/canvas": "^1.1.1",
    "@types/fabric": "^5.3.11",
    "@types/node": "^26.6.5",
    "canvas": "^3.2.3",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fabric": "^5.5.2",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "pdfjs-dist": "^6.5.438",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
