{
  "name": "@digs/react-fabric-fiber",
  "version": "2.0.0",
  "description": "A custom React reconciler that renders fabric.js canvases from JSX",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "prepack": "pnpm build",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "fabric": ">=5.3.5 <6",
    "react": ">=19.1.0 <20"
  },
  "dependencies": {
    "its-fine": "^2.1.1",
    "react-reconciler": ">=0.32.0 <0.33.0"
  },
  "devDependencies": {
    "@types/fabric": "^5.3.11",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-reconciler": ">=0.32.0 <0.33.0",
    "fabric": "^5.5.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^9.0.0"
  }
}
